# Files git should not track in the harness. All of these are created by tools and can be
# rebuilt at any time, so committing them would only clutter the repository.

# Gradle's working files and caches
.gradle/
# Compiled classes, test reports, harness-agent.jar, sim logs
build/
# Machine-specific paths written by Android Studio
local.properties
# Android Studio / IntelliJ project files
*.iml
.idea/

# Unity's generated folders and IDE files in the Unity project (unity/). Unity rebuilds them;
# only Assets/, Packages/ and ProjectSettings/ are kept.
/unity/[Ll]ibrary/
/unity/[Tt]emp/
/unity/[Ll]ogs/
/unity/[Oo]bj/
/unity/[Uu]ser[Ss]ettings/
/unity/[Bb]uild/
/unity/[Bb]uilds/
/unity/.vs/
/unity/.vscode/
/unity/*.csproj
/unity/*.sln
/unity/*.slnx

# The art inbox: downloads dropped here before Claude sorts them into the Unity project. Large,
# so never committed; only its README (the checklist) is kept.
/art-inbox/*
!/art-inbox/README.md

# Temporary copy of the raw Mixamo files while Harness -> Build People runs (it deletes the folder after).
/unity/Assets/HarnessReplay/PeopleSource/
/unity/Assets/HarnessReplay/PeopleSource.meta
